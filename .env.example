# PulseGate Environment Variables
# Copy this file to .env before starting the services

# Gateway Server Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Trusted Upstream Microservice Configuration
UPSTREAM_BASE_URL=http://localhost:4001

# API Authentication Keys
DEMO_API_KEY=replace-with-local-demo-key
ADMIN_API_KEY=replace-with-separate-admin-key

# Gateway Limits & Storage
REQUEST_LOG_LIMIT=500

